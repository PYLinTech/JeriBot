#pragma code_page(65001)
#include <windows.h>
#include "resource_ids.h"

// 应用程序图标
MAINICON ICON "../JeriBot_Icon.ico"

// 嵌入静态资源
RES_INDEX_HTML      RCDATA "Assets/index.html"
RES_STYLE_CSS       RCDATA "Assets/style.css"
RES_APP_JS          RCDATA "Assets/app.js"
RES_REMIXICON_CSS   RCDATA "Assets/remixicon.css"
RES_REMIXICON_WOFF2 RCDATA "Assets/remixicon.woff2"
RES_FAVICON_ICO     RCDATA "../JeriBot_Icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 26,5,16,0
 PRODUCTVERSION 26,5,16,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "重庆沛雨霖科技有限公司"
            VALUE "FileDescription", "杰睿 JeriBot"
            VALUE "FileVersion", "260516"
            VALUE "InternalName", "JeriBot"
            VALUE "LegalCopyright", "重庆沛雨霖科技有限公司"
            VALUE "OriginalFilename", "JeriBot.exe"
            VALUE "ProductName", "杰睿 JeriBot"
            VALUE "ProductVersion", "260516"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END